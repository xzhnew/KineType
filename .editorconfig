# Keep the tree consistent without a linter. Mirrors the conventions used by
# WinUI / WinUIonWeb repositories: 2-space JS/Vue, 4-space Python, LF, UTF-8.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.py]
indent_size = 4

[*.md]
trim_trailing_whitespace = false
