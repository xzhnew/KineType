[
  { "text": "喂，您好，", "start": 0.25, "end": 0.63 },
  { "text": "这里是保险公司。", "start": 0.69, "end": 1.31 },
  { "text": "[倒鸭子]？", "start": 1.47, "end": 1.90 },
  { "text": "您说的是……", "start": 2.05, "end": 2.55 },
  { "text": "什么鸭子？", "start": 2.70, "end": 3.20 },
  { "text": "就是那个，", "start": 3.35, "end": 3.80 },
  { "text": "[倒]了的鸭子啊。", "start": 3.95, "end": 4.60 },
  { "text": "先生，您能描述一下|现场情况吗？", "start": 4.75, "end": 5.70 },
  { "text": "我的车，把一只鸭子给撞了，", "start": 5.85, "end": 6.80 },
  { "text": "它[倒]在路边。", "start": 6.95, "end": 7.60 },
  { "text": "好的，请问鸭子现在怎么样？", "start": 7.75, "end": 8.70 },
  { "text": "它[倒]着，但是它[没死]。", "start": 8.85, "end": 9.60 }
]
